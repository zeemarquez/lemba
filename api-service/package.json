{
  "name": "modern-markdown-editor-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for converting Markdown documents to PDF using Modern Markdown Editor templates",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "copy-fonts": "node scripts/copy-fonts.cjs",
    "prebuild": "node scripts/copy-fonts.cjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0-rc2",
    "@myriaddreamin/typst.ts": "^0.7.0-rc2",
    "express": "^4.21.2",
    "firebase-admin": "^13.9.0",
    "gray-matter": "^4.0.3",
    "jose": "^5.10.0",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "marked-katex-extension": "^5.1.6",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.1",
    "tex-to-typst": "^0.0.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/swagger-ui-express": "^4.1.6",
    "platejs": "^52.0.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
